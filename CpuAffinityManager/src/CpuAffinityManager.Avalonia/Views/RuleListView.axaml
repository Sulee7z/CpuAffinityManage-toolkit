<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CpuAffinityManager.Avalonia.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="700"
             x:Class="CpuAffinityManager.Avalonia.Views.RuleListView"
             x:DataType="vm:RuleListViewModel"
             x:CompileBindings="True">

    <Grid RowDefinitions="Auto,Auto,*">
        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <StackPanel Spacing="4">
                <TextBlock Text="规则" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Text="用通配符匹配来配置 CPU 亲和性规则" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Content="导出" Classes="outline" Command="{Binding ExportRulesCommand}"/>
                <Button Content="导入" Classes="outline" Command="{Binding ImportRulesCommand}"/>
                <Button Content="+ 新建" Classes="primary" Command="{Binding AddRuleCommand}"/>
            </StackPanel>
        </Grid>

        <!-- Batch actions (visible when rules exist) -->
        <Border Grid.Row="1" IsVisible="{Binding HasRules}" Padding="8,6" Margin="0,6,0,6"
                Background="{DynamicResource SurfaceHoverBrush}" CornerRadius="6">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Button Grid.Column="0" Content="{Binding SelectAllText}" Classes="outline" FontSize="11"
                        Padding="6,3" Command="{Binding ToggleSelectAllCommand}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <TextBlock Grid.Column="1" Text="{Binding Rules.Count, StringFormat=共 {0} 条规则}"
                           FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                    <Button Content="✓ 切换选中" Classes="outline" FontSize="11" Padding="6,3"
                            Command="{Binding ToggleSelectedRulesCommand}"/>
                    <Button Content="✕ 删除选中" Classes="danger" FontSize="11" Padding="6,3"
                            Command="{Binding DeleteSelectedCommand}"/>
                    <Button Content="⏻ 关闭全部" Classes="outline" FontSize="11" Padding="6,3"
                            Command="{Binding DisableAllCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Rules List -->
        <ScrollViewer Grid.Row="2">
            <ItemsControl ItemsSource="{Binding Rules}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:RuleItem">
                        <Border Classes.card="True" Classes.disabled="{Binding !Enabled}"
                                Padding="14" Margin="0,0,0,6">
                            <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}"
                                          VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding Enabled}"
                                              VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <StackPanel Grid.Column="2" Spacing="3">
                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <WrapPanel>
                                        <Border CornerRadius="10" Padding="8,2" Background="{DynamicResource PrimaryBgBrush}" Margin="0,0,4,2">
                                            <TextBlock Text="{Binding Mode}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}"/>
                                        </Border>
                                        <Border CornerRadius="10" Padding="8,2" Background="{DynamicResource PrimaryBgBrush}" Margin="0,0,4,2">
                                            <TextBlock Text="{Binding Level}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}"/>
                                        </Border>
                                    </WrapPanel>
                                    <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}">
                                        <Run Text="匹配: "/><Run Text="{Binding ProcessPattern}"/>
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Spacing="2">
                                    <Button Content="✎" Classes="ghost" FontSize="13"
                                            Command="{Binding $parent[UserControl].DataContext.EditRuleCommand}" CommandParameter="{Binding .}"/>
                                    <Button Content="✕" Classes="ghost" FontSize="13" Foreground="{DynamicResource DangerBrush}"
                                            Command="{Binding $parent[UserControl].DataContext.DeleteRuleCommand}" CommandParameter="{Binding .}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Empty State -->
        <Border Grid.Row="2" IsVisible="{Binding !HasRules}" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="40">
            <StackPanel Spacing="12" HorizontalAlignment="Center">
                <TextBlock Text="📏" FontSize="36" HorizontalAlignment="Center"/>
                <TextBlock Text="尚未配置规则" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Text="点击右上角『+ 新建』创建第一条规则" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>