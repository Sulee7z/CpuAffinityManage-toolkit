<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════════════════════════════════════════════════════
         Windows 11 (Fluent) palette — follows the system light/dark
         theme via ThemeDictionaries. Reference these with DynamicResource
         so they switch live when the OS theme changes.
         ═══════════════════════════════════════════════════════════ -->
    <ResourceDictionary.ThemeDictionaries>

        <!-- ───────── Light ───────── -->
        <ResourceDictionary x:Key="Light">
            <!-- Accent (Win11 default light accent) -->
            <Color x:Key="PrimaryColor">#005FB8</Color>
            <Color x:Key="PrimaryDarkColor">#005094</Color>
            <Color x:Key="PrimaryLightColor">#4C9AE0</Color>
            <Color x:Key="PrimaryBgColor">#EFF6FC</Color>

            <!-- Surfaces (Mica base + layered cards) -->
            <Color x:Key="BgColor">#F3F3F3</Color>
            <Color x:Key="SurfaceColor">#FFFFFF</Color>
            <Color x:Key="SurfaceHoverColor">#F7F7F7</Color>
            <Color x:Key="SurfacePressedColor">#EFEFEF</Color>
            <Color x:Key="SidebarBgColor">#F0F0F2</Color>
            <Color x:Key="SidebarHoverColor">#E6E6E8</Color>
            <Color x:Key="SidebarActiveColor">#FFFFFF</Color>

            <!-- Text -->
            <Color x:Key="TextPrimaryColor">#1B1B1B</Color>
            <Color x:Key="TextSecondaryColor">#5D5D5D</Color>
            <Color x:Key="TextMutedColor">#8A8A8A</Color>
            <Color x:Key="TextOnDarkColor">#1B1B1B</Color>
            <Color x:Key="TextOnPrimaryColor">#FFFFFF</Color>

            <!-- Lines -->
            <Color x:Key="BorderColor">#E5E5E5</Color>
            <Color x:Key="DividerColor">#ECECEC</Color>

            <!-- Semantic -->
            <Color x:Key="SuccessColor">#0F7B0F</Color>
            <Color x:Key="WarningColor">#9D5D00</Color>
            <Color x:Key="DangerColor">#C42B1C</Color>
            <Color x:Key="InfoColor">#005FB8</Color>
            <Color x:Key="DangerHoverColor">#B02419</Color>

            <!-- Core types -->
            <Color x:Key="PcoreColor">#C42B1C</Color>
            <Color x:Key="PcoreSmtColor">#CA5010</Color>
            <Color x:Key="EcoreColor">#005FB8</Color>
            <Color x:Key="JobEnforcedColor">#C42B1C</Color>

            <!-- Tinted backgrounds -->
            <Color x:Key="DangerBgColor">#FDE7E9</Color>
            <Color x:Key="WarningBgColor">#FFF4CE</Color>
            <Color x:Key="InfoBgColor">#E8F1FB</Color>
            <Color x:Key="SuccessBgColor">#E7F5E7</Color>

            <!-- Brushes -->
            <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
            <SolidColorBrush x:Key="PrimaryDarkBrush" Color="{StaticResource PrimaryDarkColor}"/>
            <SolidColorBrush x:Key="PrimaryLightBrush" Color="{StaticResource PrimaryLightColor}"/>
            <SolidColorBrush x:Key="PrimaryBgBrush" Color="{StaticResource PrimaryBgColor}"/>
            <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}"/>
            <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
            <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHoverColor}"/>
            <SolidColorBrush x:Key="SurfacePressedBrush" Color="{StaticResource SurfacePressedColor}"/>
            <SolidColorBrush x:Key="SidebarBgBrush" Color="{StaticResource SidebarBgColor}"/>
            <SolidColorBrush x:Key="SidebarHoverBrush" Color="{StaticResource SidebarHoverColor}"/>
            <SolidColorBrush x:Key="SidebarActiveBrush" Color="{StaticResource SidebarActiveColor}"/>
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
            <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}"/>
            <SolidColorBrush x:Key="TextOnDarkBrush" Color="{StaticResource TextOnDarkColor}"/>
            <SolidColorBrush x:Key="TextOnPrimaryBrush" Color="{StaticResource TextOnPrimaryColor}"/>
            <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
            <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource DividerColor}"/>
            <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
            <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
            <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
            <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}"/>
            <SolidColorBrush x:Key="DangerHoverBrush" Color="{StaticResource DangerHoverColor}"/>
            <SolidColorBrush x:Key="PcoreBrush" Color="{StaticResource PcoreColor}"/>
            <SolidColorBrush x:Key="PcoreSmtBrush" Color="{StaticResource PcoreSmtColor}"/>
            <SolidColorBrush x:Key="EcoreBrush" Color="{StaticResource EcoreColor}"/>
            <SolidColorBrush x:Key="DangerBgBrush" Color="{StaticResource DangerBgColor}"/>
            <SolidColorBrush x:Key="WarningBgBrush" Color="{StaticResource WarningBgColor}"/>
            <SolidColorBrush x:Key="InfoBgBrush" Color="{StaticResource InfoBgColor}"/>
            <SolidColorBrush x:Key="SuccessBgBrush" Color="{StaticResource SuccessBgColor}"/>
        </ResourceDictionary>

        <!-- ───────── Dark ───────── -->
        <ResourceDictionary x:Key="Dark">
            <!-- Accent (Win11 default dark accent) -->
            <Color x:Key="PrimaryColor">#60CDFF</Color>
            <Color x:Key="PrimaryDarkColor">#4CC2FF</Color>
            <Color x:Key="PrimaryLightColor">#99DEFF</Color>
            <Color x:Key="PrimaryBgColor">#12333F</Color>

            <!-- Surfaces -->
            <Color x:Key="BgColor">#202020</Color>
            <Color x:Key="SurfaceColor">#2B2B2B</Color>
            <Color x:Key="SurfaceHoverColor">#323232</Color>
            <Color x:Key="SurfacePressedColor">#272727</Color>
            <Color x:Key="SidebarBgColor">#262626</Color>
            <Color x:Key="SidebarHoverColor">#2F2F2F</Color>
            <Color x:Key="SidebarActiveColor">#2D2D2D</Color>

            <!-- Text -->
            <Color x:Key="TextPrimaryColor">#FFFFFF</Color>
            <Color x:Key="TextSecondaryColor">#CFCFCF</Color>
            <Color x:Key="TextMutedColor">#9A9A9A</Color>
            <Color x:Key="TextOnDarkColor">#FFFFFF</Color>
            <Color x:Key="TextOnPrimaryColor">#000000</Color>

            <!-- Lines -->
            <Color x:Key="BorderColor">#333333</Color>
            <Color x:Key="DividerColor">#2A2A2A</Color>

            <!-- Semantic -->
            <Color x:Key="SuccessColor">#6CCB5F</Color>
            <Color x:Key="WarningColor">#FCE100</Color>
            <Color x:Key="DangerColor">#FF99A4</Color>
            <Color x:Key="InfoColor">#60CDFF</Color>
            <Color x:Key="DangerHoverColor">#FFB2BA</Color>

            <!-- Core types -->
            <Color x:Key="PcoreColor">#FF99A4</Color>
            <Color x:Key="PcoreSmtColor">#F7A67B</Color>
            <Color x:Key="EcoreColor">#60CDFF</Color>
            <Color x:Key="JobEnforcedColor">#FF99A4</Color>

            <!-- Tinted backgrounds -->
            <Color x:Key="DangerBgColor">#442726</Color>
            <Color x:Key="WarningBgColor">#433519</Color>
            <Color x:Key="InfoBgColor">#123342</Color>
            <Color x:Key="SuccessBgColor">#1E3A23</Color>

            <!-- Brushes -->
            <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
            <SolidColorBrush x:Key="PrimaryDarkBrush" Color="{StaticResource PrimaryDarkColor}"/>
            <SolidColorBrush x:Key="PrimaryLightBrush" Color="{StaticResource PrimaryLightColor}"/>
            <SolidColorBrush x:Key="PrimaryBgBrush" Color="{StaticResource PrimaryBgColor}"/>
            <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}"/>
            <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
            <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHoverColor}"/>
            <SolidColorBrush x:Key="SurfacePressedBrush" Color="{StaticResource SurfacePressedColor}"/>
            <SolidColorBrush x:Key="SidebarBgBrush" Color="{StaticResource SidebarBgColor}"/>
            <SolidColorBrush x:Key="SidebarHoverBrush" Color="{StaticResource SidebarHoverColor}"/>
            <SolidColorBrush x:Key="SidebarActiveBrush" Color="{StaticResource SidebarActiveColor}"/>
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
            <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}"/>
            <SolidColorBrush x:Key="TextOnDarkBrush" Color="{StaticResource TextOnDarkColor}"/>
            <SolidColorBrush x:Key="TextOnPrimaryBrush" Color="{StaticResource TextOnPrimaryColor}"/>
            <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
            <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource DividerColor}"/>
            <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
            <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
            <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
            <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}"/>
            <SolidColorBrush x:Key="DangerHoverBrush" Color="{StaticResource DangerHoverColor}"/>
            <SolidColorBrush x:Key="PcoreBrush" Color="{StaticResource PcoreColor}"/>
            <SolidColorBrush x:Key="PcoreSmtBrush" Color="{StaticResource PcoreSmtColor}"/>
            <SolidColorBrush x:Key="EcoreBrush" Color="{StaticResource EcoreColor}"/>
            <SolidColorBrush x:Key="DangerBgBrush" Color="{StaticResource DangerBgColor}"/>
            <SolidColorBrush x:Key="WarningBgBrush" Color="{StaticResource WarningBgColor}"/>
            <SolidColorBrush x:Key="InfoBgBrush" Color="{StaticResource InfoBgColor}"/>
            <SolidColorBrush x:Key="SuccessBgBrush" Color="{StaticResource SuccessBgColor}"/>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Theme-agnostic: subtle Win11 elevation shadows -->
    <BoxShadows x:Key="ShadowSm">0 1 3 #00000012</BoxShadows>
    <BoxShadows x:Key="ShadowMd">0 6 18 #0000001F</BoxShadows>
    <BoxShadows x:Key="ShadowLg">0 12 32 #0000002E</BoxShadows>

</ResourceDictionary>
